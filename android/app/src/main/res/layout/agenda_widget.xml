<?xml version="1.0" encoding="utf-8"?>
<!-- Los textos de ejemplo solo se ven en la vista previa del selector de widgets; AgendaWidgetProvider los sustituye -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingTop="14dp"
    android:paddingRight="16dp"
    android:paddingBottom="10dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lunes, 21 sep"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/widget_text"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:text="1 de 4 completadas"
        android:textSize="12sp"
        android:textColor="@color/widget_muted"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_task1"
        style="@style/WidgetTaskRow"
        android:text="☐ Llamar al dentista" />

    <TextView
        android:id="@+id/widget_task2"
        style="@style/WidgetTaskRow"
        android:text="☐ Comprar pan" />

    <TextView
        android:id="@+id/widget_task3"
        style="@style/WidgetTaskRow"
        android:text="☐ Preparar la reunión" />

    <TextView
        android:id="@+id/widget_task4"
        style="@style/WidgetTaskRow"
        android:text="" />

</LinearLayout>
